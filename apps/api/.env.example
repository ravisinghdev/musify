# Musify API Environment Template
# Copy this file to .env and fill in your real values

# Supabase / PostgreSQL database connection (pooled and direct)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# High-entropy JWT signing secret for sessions
JWT_SECRET="musify-production-secret-key-replace-with-secure-random-bytes"

# Google Gemini API key for AI Smart DJ playlist generation (gemini-3.6-flash)
GEMINI_API_KEY="your-gemini-api-key"

# Port configuration
PORT=3001
