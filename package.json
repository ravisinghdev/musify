{
  "name": "musify",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:exe": "pnpm --filter musify-desktop run dist",
    "build:apk": "pnpm --filter web exec cap sync android && cd apps/web/android && gradlew.bat assembleDebug",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  }
}
